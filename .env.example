# ============================================================
# SceneStealer — copy to `.env` and fill in. NEVER commit .env
# Owner column = who is responsible for obtaining the key.
# ============================================================

# ---- Huawei OMNI (Qwen3.5-Omni via yibuapi) -------------- REQUIRED
# From the yibuapi credit email. Apply once per team: luma.com/0fhypcu0
# 40 CAD cap: develop on OMNI_MODEL_DEV, demo on OMNI_MODEL.
OMNI_BASE_URL=
OMNI_API_KEY=
OMNI_MODEL=
OMNI_MODEL_DEV=
OMNI_USE_DEV_MODEL=true   # false only for the real demo
OMNI_TIMEOUT_S=20         # past this the round falls back

# ---- OpenAI (judge dialogue) ----------------------------- REQUIRED
OPENAI_API_KEY=
OPENAI_MODEL_JUDGES=gpt-4.1-mini

# ---- ElevenLabs (judge voices, SFX, dub) ----------------- REQUIRED
# Voice IDs come from Voice Design; create once, paste here.
ELEVENLABS_API_KEY=
VOICE_JUDGE_FACE=
VOICE_JUDGE_BODY=
VOICE_JUDGE_VOICE=
# NOTE: the dub voice ID lives in the scene pack, not here.

# ---- Baseten (SAM 2 character isolation, prep only) ------ REQUIRED for prep
BASETEN_API_KEY=
SAM2_ENDPOINT_URL=

# ---- MongoDB Atlas (scene packs, results, leaderboard) --- REQUIRED
MONGODB_URI=
MONGODB_DB=scenestealer

# ---- Scene selection ------------------------------------- REQUIRED
# Any scene_id under scenes/. Swapping scenes = change this, nothing else.
ACTIVE_SCENE=dev-clip
DEFAULT_THRESHOLD=70

# ---- Local runtime (safe defaults, no need to change) ----
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
WEB_PORT=5173
DATA_DIR=data
FFMPEG_BIN=ffmpeg
# Delete raw player takes after scoring (Huawei privacy bonus). 1 = delete.
DELETE_TAKES_AFTER_SCORING=1
# Force offline/fallback mode for the "Wi-Fi died" rehearsal. 1 = force.
FORCE_FALLBACK=0
